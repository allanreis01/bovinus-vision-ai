# =====================================================================
#  Bovinu'S Vision AI — Variáveis de ambiente
#  Copie este arquivo para ".env" (na raiz do projeto) e ajuste os valores.
#  O arquivo .env está no .gitignore e NUNCA deve ser versionado.
# =====================================================================

# ---------------------------------------------------------------------
# Google Gemini Vision (OPCIONAL)
# Chave gratuita em: https://aistudio.google.com/apikey
# Se ficar VAZIA, o sistema usa automaticamente o analisador local de
# Visão Computacional (histograma de cores HSV + segmentação por regiões
# + heurística de densidade). A demonstração NUNCA quebra.
# ---------------------------------------------------------------------
GEMINI_API_KEY=

# Modelo multimodal usado na análise do prato (padrão: gemini-2.5-flash)
GEMINI_MODEL=gemini-2.5-flash

# Tempo máximo (ms) aguardando o Gemini antes de cair no fallback local
GEMINI_TIMEOUT_MS=15000

# ---------------------------------------------------------------------
# Servidor da API (backend Express)
# ---------------------------------------------------------------------
PORT=3001

# Caminho do banco SQLite (relativo à pasta backend/). Criado e populado
# automaticamente com dados realistas da Unidade Augusta na 1ª execução.
DB_PATH=data/bovinus.db
